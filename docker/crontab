# ─────────────────────────────────────────────
# supercronic crontab — 容器内定时任务
# 时区: Asia/Shanghai (由 Dockerfile TZ 环境变量控制)
# supercronic 格式与标准 cron 完全兼容，支持秒级日志输出
# ─────────────────────────────────────────────

# ── CNE 数据湖日更流水线（收盘后按 wave 顺序跑全组，含 compact/audit）
35 15 * * 1-5 bash /app/docker/run_cne_daily.sh >> /var/log/supervisor/cron-cne-daily.log 2>&1

# ── quant_ui ETF/基金/指数增量刷新（CNE 日更完成后补齐 quant_ui 自有数据）
10 16 * * 1-5 cd /app && python scripts/refresh_data.py --workers 1 --skip-stock-panel --no-sync-pg --no-rebuild-panel >> /var/log/supervisor/cron-data-refresh.log 2>&1

# ── quant_ui 股票 panel 增量重建（复权锚点不变则只追加新日期，代价小）
20 16 * * 1-5 cd /app && python scripts/rebuild_stock_panel_from_pg.py >> /var/log/supervisor/cron-panel-rebuild.log 2>&1

# ── ML 组合训练（walk-forward stacking；自门禁：跨入新月才真正训练，平时秒退）
40 16 * * 1-5 cd /app && python scripts/cne/stacking_job.py >> /var/log/supervisor/cron-stacking.log 2>&1

# ── 日级模拟盘交易
0 20 * * 1-5 cd /app && python scripts/paper_trade.py --run >> /var/log/supervisor/cron-paper.log 2>&1

# ── 健康检查（每5分钟）
*/5 * * * * cd /app && python scripts/healthcheck.py >> /var/log/supervisor/cron-healthcheck.log 2>&1

# ── Tushare token 到期 QQ 提醒（无 QQ bot 环境时失败但不影响其他服务）
5 9 * * * cd /app && python scripts/tushare_expiry_notify.py >> /var/log/supervisor/cron-tushare-expiry.log 2>&1
