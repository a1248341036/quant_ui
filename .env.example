# 复制为 .env 后填写（.env 已被 gitignore，不会提交）
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_URL=https://t.xiaodefa.top/
# 1=优先使用 Tushare，失败自动回退腾讯行情；0=直接用腾讯行情
TUSHARE_ENABLED=1
# 每次 Tushare 请求间最小间隔（秒），积分紧张时可调大
TUSHARE_SLEEP=0.1
# 可选：数据目录，默认项目内 data/（迁移时整个项目一起拷走即可）
# QUANT_UI_DATA_DIR=/path/to/data

# PostgreSQL/TimescaleDB（Docker: db/docker-compose.yml；数据在 db/pgdata/）
PG_DSN=postgresql://quant:quant123@127.0.0.1:5432/quant_db
# 回测数据源：pg=优先 PostgreSQL stock_daily（覆盖不足自动回退 parquet），panel=只用本地文件
QUANT_DATA_SOURCE=pg
