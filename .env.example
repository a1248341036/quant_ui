# 复制为 .env 后填写（.env 已被 gitignore，不会提交）
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_URL=https://t.xiaodefa.top/
# 1=优先使用 Tushare，失败自动回退腾讯行情；0=直接用腾讯行情
TUSHARE_ENABLED=1
# 每次 Tushare 请求间最小间隔（秒），积分紧张时可调大
TUSHARE_SLEEP=0.1
# 可选：数据目录，默认项目内 data/（迁移时整个项目一起拷走即可）
# QUANT_UI_DATA_DIR=/path/to/data
# 可选：旧独立数据目录（selftest/compare_old 对照用），默认 ~/quant_data
# QUANT_UI_LEGACY_DATA_DIR=/path/to/quant_data
# 可选：舆情独立仓库，默认 <项目父目录>/sentiment-mvp
# QUANT_UI_SENTIMENT_DIR=/path/to/sentiment-mvp
# 可选：QQ 机器人目录（健康检查/到期提醒），默认 ~/qqbot
# QUANT_UI_QQBOT_DIR=/path/to/qqbot

# 回测数据源：cne=读 data/quant_dataset 年度档案；panel=只用本地预计算面板
# pg_parquet 仍作为旧配置别名，财务宽表继续从 data/pg_parquet/ 只读桥接
QUANT_DATA_SOURCE=cne

# Optional LLM-assisted alpha research (OpenAI-compatible /v1 endpoint)
# ALPHA_LLM_PROVIDER=env
# ALPHA_LLM_API_KEY=your_api_key
# ALPHA_LLM_BASE_URL=https://api.openai.com/v1
# ALPHA_LLM_MODEL=your_model
# ALPHA_LLM_TIMEOUT=120

# Optional: use the active provider from Codex config.toml instead
# ALPHA_LLM_PROVIDER=codex
# CODEX_CONFIG=C:\Users\your_name\.codex\config.toml

# Direct AlphaAgent AgentScope mining defaults
# ALPHAAGENT_PANEL=data/alphaagent/panel_1d.parquet
# ALPHAAGENT_FACTORLIB=artifacts/alphaagent/factorzoo/stock_1d

# ---- 公网访问门禁（经 Cloudflare Tunnel 等对外暴露时才需要）----
# 门禁口令：QUANT_UI_ACCESS_KEY 优先，其次 QUANT_UI_PASSWORD；两者都为空 = 不启用门禁
# QUANT_UI_PASSWORD=your_access_password
# QUANT_UI_ACCESS_KEY=your_access_key
# 本机来源(127.0.0.1/::1)是否免密放行，默认 1（本地开发免登录）
# 经本地反向代理/隧道对外暴露时必须设 0，否则公网请求会被判成本机而静默绕过门禁
# QUANT_UI_TRUST_LOOPBACK=0
