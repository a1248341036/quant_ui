[Unit]
Description=Quant data status + script task service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/quant/quant_ui
Environment=HOME=/home/ubuntu
Environment=QUANT_UI_DATA_DIR=/home/ubuntu/quant/quant_ui/data
ExecStart=/home/ubuntu/stock-analyzer/local_venv/bin/python -m uvicorn data_status.app:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
