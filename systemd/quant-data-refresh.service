[Unit]
Description=Quant UI daily data refresh (oneshot)

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/quant/quant_ui
ExecStart=/home/ubuntu/stock-analyzer/local_venv/bin/python /home/ubuntu/quant/quant_ui/scripts/refresh_data.py --workers 1 --skip-stock-panel
Nice=10
IOSchedulingClass=idle
CPUQuota=80%
MemoryHigh=1G
MemoryMax=1536M
