[Unit]
Description=Quant UI daily data refresh (oneshot)

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=%h/quant/quant_ui
Environment=QUANT_UI_DATA_DIR=%h/quant/quant_ui/data
ExecStart=%h/stock-analyzer/local_venv/bin/python %h/quant/quant_ui/scripts/refresh_data.py --workers 1 --skip-stock-panel
Nice=10
IOSchedulingClass=idle
CPUQuota=80%
MemoryHigh=1G
MemoryMax=1536M
