[Unit]
Description=Quant UI Streamlit Dashboard
After=network.target

[Service]
User=ubuntu
WorkingDirectory=%h/quant/quant_ui
Environment=QUANT_UI_DATA_DIR=%h/quant/quant_ui/data
Environment=QUANT_UI_SENTIMENT_DIR=%h/quant/sentiment-mvp
ExecStart=%h/stock-analyzer/local_venv/bin/python -m streamlit run %h/quant/quant_ui/app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true
Restart=always
RestartSec=5
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
MemoryHigh=768M
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
