[Unit]
Description=Weekly Tencent stock panel fallback refresh (Sun 03:00)

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=%h/quant/quant_ui
Environment=QUANT_UI_DATA_DIR=%h/quant/quant_ui/data
ExecStart=%h/stock-analyzer/local_venv/bin/python %h/quant/quant_ui/scripts/refresh_data.py --workers 3 --no-sync-pg
Nice=10
IOSchedulingClass=idle
CPUQuota=80%
MemoryHigh=1G
MemoryMax=1536M
ExecStartPost=-/usr/bin/sudo -n /bin/systemctl --no-block try-restart quant-api.service
ExecStartPost=-/usr/bin/sudo -n /bin/systemctl --no-block try-restart quant-ui.service
