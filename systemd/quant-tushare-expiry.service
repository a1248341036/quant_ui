[Unit]
Description=Tushare token expiry QQ reminder (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=%h/quant/quant_ui
Environment=HOME=%h
Environment=QUANT_UI_DATA_DIR=%h/quant/quant_ui/data
Environment=QUANT_UI_QQBOT_DIR=%h/qqbot
EnvironmentFile=%h/qqbot/.env
ExecStart=%h/qqbot/.venv/bin/python %h/quant/quant_ui/scripts/tushare_expiry_notify.py
