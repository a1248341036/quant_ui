[Unit]
Description=Quant UI FastAPI Backend
After=network.target quant-data-refresh.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/quant_ui
ExecStart=/home/ubuntu/stock-analyzer/local_venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
