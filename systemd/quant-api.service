[Unit]
Description=Quant UI FastAPI Backend
After=network.target quant-data-refresh.service

[Service]
User=ubuntu
WorkingDirectory=%h/quant/quant_ui
Environment=QUANT_UI_DATA_DIR=%h/quant/quant_ui/data
ExecStart=%h/stock-analyzer/local_venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 17891
Restart=always
RestartSec=5
MemoryHigh=1024M
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
